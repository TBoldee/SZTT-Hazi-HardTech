<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VotingPlatform.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VotingPlatform"
	xmlns:view="clr-namespace:VotingPlatform.View"
    Title="VotingPlatform">

	<ShellItem>
		<ShellContent
			 Title="Log In"
			 ContentTemplate="{DataTemplate view:LogInView}"
			 Route="LogInView" />
	</ShellItem>
	<TabBar>
		<ShellContent
	        Title="Create Poll"
	        ContentTemplate="{DataTemplate view:CreatePollView}"
	        Route="CreatePollView" />
		<ShellContent
			Title="View All Polls"
			ContentTemplate="{DataTemplate view:AllPollsView}"
			Route="AllPollsView" />
	</TabBar>
    

</Shell>
