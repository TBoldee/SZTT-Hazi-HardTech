<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VotingPlatform.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VotingPlatform"
	xmlns:view="clr-namespace:VotingPlatform.View"
    Title="VotingPlatform">

	<ShellItem>
		<ShellContent
			 Title="Log In"
			 ContentTemplate="{DataTemplate view:LogInView}"
			 Route="LogInView" />
	</ShellItem>
	<TabBar x:Name="MainTabs">
		<ShellContent
			Title="View Own Polls"
			ContentTemplate="{DataTemplate view:UserPollsView}"
			Route="UserPollsView" />
		<ShellContent
			Title="View Open Polls"
			ContentTemplate="{DataTemplate view:OpenPollsView}"
			Route="OpenPollsView" />
		<ShellContent
			Title="View Closed Polls"
			ContentTemplate="{DataTemplate view:ClosedPollsView}"
			Route="ClosedPollsView" />
		<ShellContent
			Title="Create Poll"
			ContentTemplate="{DataTemplate view:CreatePollView}"
			Route="CreatePollView" />
		<ShellContent x:Name="UserList"
			Title="User List"
			ContentTemplate="{DataTemplate view:UserListView}"
			Route="UserListView" />
	</TabBar>
    

</Shell>
