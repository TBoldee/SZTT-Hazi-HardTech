<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VotingPlatform.View.CreatePollView"
             xmlns:viewModel="clr-namespace:VotingPlatform.ViewModel"
			 xmlns:model="clr-namespace:VotingPlatform.Model"
             Title="">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout x:DataType="viewModel:PollCreationViewModel" Spacing="5" Padding="5" HorizontalOptions="Center" >
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Title: "/>
                    <Entry WidthRequest="150" Text="{Binding Title}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Description: "/>
                    <Editor WidthRequest="150" Text="{Binding Description}" AutoSize="TextChanges"/>
                </HorizontalStackLayout>
                <Label Text="Options: "/>
                <HorizontalStackLayout Spacing="15">
                    <CollectionView ItemsSource="{Binding Options}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:VoteOption">
                                <StackLayout>
                                    <Entry Text="{Binding Text}" WidthRequest="150"/>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <VerticalStackLayout Spacing="15">
                        <Button x:Name="AddOptionButton" Text="Add option" MaximumHeightRequest="50" Command="{Binding AddOptionCommand}" VerticalOptions="Start"/>
                        <Button x:Name="CreatePollButton" Text="Create poll" MaximumHeightRequest="50" Command="{Binding CreatePollCommand}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>